# Copy to .cache/upstream-comparison/telegram.env and fill in locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a topic ID when sending into a Telegram forum topic.
TELEGRAM_THREAD_ID=
# Explicitly allowed human Telegram user IDs (required for selecting issues).
# Group chat IDs and usernames are not user IDs. No wildcard is accepted.
TELEGRAM_ALLOWED_USER_IDS=
# Fine-grained token restricted to ichwars/PrintOps, Issues: read/write.
# Do not reuse a personal token with unrelated permissions.
GITHUB_TOKEN=
