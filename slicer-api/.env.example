# Copy to .env and tweak. Defaults match what PrintOps expects out of the box.

# Host ports. PrintOps's virtual-printer feature already binds 3000 and
# 3002, so the OrcaSlicer sidecar sits on 3003. Move them if you run
# this stack on a different host or want to free those ports for VPs.
ORCA_API_PORT=3003
BAMBU_API_PORT=3001

# Existing third-party prebuilt image tag; availability is maintainer-controlled.
# Choose a tag that actually exists in the corresponding GHCR repository.
# PrintOps releases do not publish or guarantee tags in these repositories.
# compose.native.yml builds its own pinned Orca image and ignores this tag for Orca.
SIDECAR_TAG=latest
